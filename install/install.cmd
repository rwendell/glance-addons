@echo off
rem Installs the Glance plugin manager and its config scaffold.
rem The manager loads from jsDelivr by default. Pass --local or set
rem GLANCE_PLUGINS_LOCAL=1 to download a local copy.
setlocal EnableExtensions EnableDelayedExpansion

set "CONFIG="
if defined XDG_CONFIG_HOME set "CONFIG=%XDG_CONFIG_HOME%\glance"
if not defined CONFIG set "CONFIG=%USERPROFILE%\.config\glance"
if defined GLANCE_CONFIG set "CONFIG=%GLANCE_CONFIG%"

set "REF=main"
if defined GLANCE_PLUGINS_REF set "REF=%GLANCE_PLUGINS_REF%"

set "LOCAL=0"
if defined GLANCE_PLUGINS_LOCAL set "LOCAL=1"
if /I "%~1"=="--local" set "LOCAL=1"
if /I "%~1"=="--remote" set "LOCAL=0"
if /I "%~1"=="--help" (
    echo Usage: install.cmd [--local]
    echo Set GLANCE_CONFIG to choose the config directory.
    echo Set GLANCE_PLUGINS_LOCAL=1 to download a local manager copy.
    exit /b 0
)

for %%I in ("%CONFIG%") do set "CONFIG=%%~fI"

set "ASSETS=%CONFIG%\assets"
set "PAGES=%CONFIG%\pages"
set "GLANCE=%CONFIG%\glance.yml"
set "HOME_PAGE=%PAGES%\home.yml"
set "PLUGINS=%CONFIG%\plugins.json"
set "SERVED=%ASSETS%\plugins.json"
set "TARGET=%ASSETS%\plugin-manager.js"
set "RAW=https://raw.githubusercontent.com/rwendell/glance-addons/%REF%"
set "REMOTE_URL=https://cdn.jsdelivr.net/gh/rwendell/glance-addons@%REF%/plugins/plugin-manager/dist/plugin-manager.js"
set "SCRIPT_SRC=%REMOTE_URL%"
set "MARKER=# Generated by the glance-addons installer."
set "LEGACY_MARKER=# Generated by the glance-plugins installer."
set "BACKUP="
set "MOVED_MANAGER="

set "GENERATED=0"
if exist "%GLANCE%" (
    findstr /c:"%MARKER%" "%GLANCE%" >nul 2>nul
    if not errorlevel 1 set "GENERATED=1"
    findstr /c:"%LEGACY_MARKER%" "%GLANCE%" >nul 2>nul
    if not errorlevel 1 set "GENERATED=1"
)

if "%GENERATED%"=="0" (
    if exist "%CONFIG%" (
        dir /b /a "%CONFIG%" >nul 2>nul
        if not errorlevel 1 (
            call :backup "%CONFIG%"
            if errorlevel 1 exit /b 1
            set "BACKUP=!BACKUP_PATH!"
            echo Backed up existing config to !BACKUP!
        )
    )
)

if not exist "%CONFIG%" mkdir "%CONFIG%"
if not exist "%ASSETS%" mkdir "%ASSETS%"
if not exist "%ASSETS%\themes" mkdir "%ASSETS%\themes"
if not exist "%PAGES%" mkdir "%PAGES%"

if defined BACKUP (
    if exist "!BACKUP!\assets" (
        xcopy /E /I /Y "!BACKUP!\assets" "%ASSETS%" >nul
        if errorlevel 2 (
            echo Could not copy assets from the backup.
            exit /b 1
        )
        del /f /q "%TARGET%" 2>nul
        del /f /q "%TARGET%.bak*" 2>nul
        del /f /q "%SERVED%" 2>nul
    )

    if exist "!BACKUP!\pages" (
        xcopy /E /I /Y "!BACKUP!\pages" "%PAGES%" >nul
        if errorlevel 2 (
            echo Could not copy pages from the backup.
            exit /b 1
        )
    )

    if exist "!BACKUP!\plugins.json" (
        copy /y "!BACKUP!\plugins.json" "%PLUGINS%" >nul
        if errorlevel 1 (
            echo Could not copy plugins.json from the backup.
            exit /b 1
        )
    ) else (
        if exist "!BACKUP!\assets\plugins.json" (
            copy /y "!BACKUP!\assets\plugins.json" "%PLUGINS%" >nul
            if errorlevel 1 (
                echo Could not copy plugins.json from the backup.
                exit /b 1
            )
        )
    )
)

if "%LOCAL%"=="1" (
    set "SCRIPT_SRC=/assets/plugin-manager.js"
    where curl.exe >nul 2>nul
    if errorlevel 1 (
        echo curl.exe is required. Windows 10 and 11 include it.
        exit /b 1
    )
    echo Downloading plugin-manager (%REF%)...
    curl.exe -fsSL "%RAW%/plugins/plugin-manager/dist/plugin-manager.js" -o "%TARGET%"
    if errorlevel 1 (
        echo Failed to download plugin-manager.
        exit /b 1
    )
) else (
    if exist "%TARGET%" (
        call :backup "%TARGET%"
        if errorlevel 1 exit /b 1
        set "MOVED_MANAGER=!BACKUP_PATH!"
        echo Moved local manager to !MOVED_MANAGER!
    )
)

if not exist "%PLUGINS%" (
    if exist "%SERVED%" (
        move "%SERVED%" "%PLUGINS%" >nul
        echo Moved %SERVED% to %PLUGINS%
    ) else (
        echo {> "%PLUGINS%"
        echo   "plugins": []>> "%PLUGINS%"
        echo }>> "%PLUGINS%"
        echo Created %PLUGINS%
    )
)

if not exist "%SERVED%" (
    mklink "%SERVED%" "%PLUGINS%" >nul 2>nul
    if errorlevel 1 (
        mklink /H "%SERVED%" "%PLUGINS%" >nul 2>nul
        if errorlevel 1 (
            copy /y "%PLUGINS%" "%SERVED%" >nul
            echo Warning: could not create a link at %SERVED%.
            echo Created a copy instead. Delete that file and run this installer
            echo again after enabling Developer Mode or running as Administrator.
        ) else (
            echo Created hard link %SERVED% to %PLUGINS%
        )
    ) else (
        echo Linked %SERVED% to %PLUGINS%
    )
)

set "HAVE_PAGES=0"
dir /b "%PAGES%\*.yml" >nul 2>nul
if not errorlevel 1 set "HAVE_PAGES=1"

if "!HAVE_PAGES!"=="0" (
    (
        echo %MARKER%
        echo # One page. Add more files under pages/ and include them from glance.yml.
        echo - name: Home
        echo   columns:
        echo     - size: full
        echo       widgets:
        echo         - type: search
        echo           hide-header: true
        echo           autofocus: true
    ) > "%HOME_PAGE%"
    if errorlevel 1 (
        echo Could not create %HOME_PAGE%.
        exit /b 1
    )
    echo Created %HOME_PAGE%
)

if "%GENERATED%"=="1" (
    echo Keeping existing %GLANCE%
    findstr /c:"%SCRIPT_SRC%" "%GLANCE%" >nul 2>nul
    if errorlevel 1 (
        echo.
        echo Note: %GLANCE% does not contain the current manager URL:
        echo   %SCRIPT_SRC%
        echo Update its script tag or remove the file and rerun.
    )
) else (
    (
        echo %MARKER%
        echo # Add pages with: - $include: pages/[name].yml
        echo # Move theme, branding, auth, and other top-level settings here.
        echo.
        echo server:
        echo   assets-path: '%ASSETS%'
        echo.
        echo document:
        echo   head: ^|
        echo     ^<script src="%SCRIPT_SRC%"^>^</script^>
        echo.
        echo pages:
        if exist "%HOME_PAGE%" echo   - $include: pages/home.yml

        for %%F in ("%PAGES%\*.yml") do (
            if /I not "%%~nxF"=="home.yml" echo   - $include: pages/%%~nxF
        )
    ) > "%GLANCE%"
    if errorlevel 1 (
        echo Could not create %GLANCE%.
        exit /b 1
    )

    echo Created %GLANCE%
)

echo.
if "%LOCAL%"=="1" (
    echo Plugin manager installed locally at %TARGET%
) else (
    echo Plugin manager loads from %REMOTE_URL%
)
echo Plugin config: %PLUGINS%
echo Glance entry point: %GLANCE%
echo Pages: %PAGES%

if defined BACKUP (
    echo.
    echo Your previous config was moved to:
    echo   !BACKUP!
    echo The new config kept plugins.json, pages/, and assets/ from the backup.
    echo Move any page definitions still in the backup glance.yml into pages/,
    echo copy theme, branding, auth, and other settings into %GLANCE%,
    echo and copy any other files you need from the backup.
)

echo.
echo Edit %PLUGINS% to add plugins.
exit /b 0

:backup
set "BACKUP_PATH=%~1.bak"
set "N=0"
:backup_loop
if exist "!BACKUP_PATH!" (
    set /a N+=1
    set "BACKUP_PATH=%~1.bak.!N!"
    goto backup_loop
)
move "%~1" "!BACKUP_PATH!" >nul
if errorlevel 1 (
    echo Could not move "%~1" to "!BACKUP_PATH!".
    exit /b 1
)
exit /b 0
